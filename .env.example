# InfraVision AI - Environment Variables Template
# Copy this to .env file and fill in your values
# DO NOT commit .env file to git

# ============ Flask Configuration ============
FLASK_ENV=production
FLASK_DEBUG=False
SECRET_KEY=your-super-secret-key-change-this-12345

# ============ Server Configuration ============
PORT=5000
HOST=0.0.0.0
MAX_CONTENT_LENGTH=52428800
REQUEST_TIMEOUT=60

# ============ Frontend Configuration ============
REACT_APP_API_URL=http://localhost:5002
REACT_APP_ENV=development

# ============ CORS Configuration ============
CORS_ORIGINS=http://localhost:3000,http://localhost:5002

# ============ Database Configuration ============
DATABASE_URL=sqlite:///app.db
# For PostgreSQL:
# DATABASE_URL=postgresql://user:password@host:5432/database_name

# ============ ML Model Configuration ============
YOLO_MODEL_PATH=runs/detect/train3/weights/best.pt
SEG_MODEL_PATH=segmentation_model/weights/best.pt
USE_GPU=False

# ============ Video Processing Configuration ============
MAX_FRAMES_TO_PROCESS=8
MAX_VIDEO_SIZE=1000
VIDEO_TIMEOUT=60
TEMP_FILES_PATH=/tmp

# ============ API Keys & Services ============
# Add any API keys or service credentials here
# GOOGLE_API_KEY=your-key-here
# AWS_ACCESS_KEY=your-key-here

# ============ Logging Configuration ============
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# ============ Render Deployment Specific ============
# Only set these when deploying on Render
# RENDER=true
# RENDER_SERVICE_NAME=infravision-ai-backend
# RENDER_REGION=us-east
