# Git XET for large binary files
*.png filter=xet diff=xet merge=xet -text
*.jpg filter=xet diff=xet merge=xet -text
*.jpeg filter=xet diff=xet merge=xet -text
*.gif filter=xet diff=xet merge=xet -text
*.bmp filter=xet diff=xet merge=xet -text
*.tiff filter=xet diff=xet merge=xet -text
*.webp filter=xet diff=xet merge=xet -text
# Model weights
*.pt filter=xet diff=xet merge=xet -text
*.pth filter=xet diff=xet merge=xet -text
*.onnx filter=xet diff=xet merge=xet -text
*.h5 filter=xet diff=xet merge=xet -text
# Event logs
events.out.tfevents.* filter=xet diff=xet merge=xet -text
