q# Ignore node modules across the repository
node_modules/
**/node_modules/

# Optional: ignore common node artifacts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# Environment Variables - CRITICAL FOR SECURITY
.env
.env.local
.env.production
.env.development
.env.*.local
render.secret
render.env

# Python Virtual Environments
venv/
ENV/
env/
.venv
infra/
*.egg-info/
.Python
*.so

# Python cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Build and Dependencies
frontend/build/
frontend/dist/
frontend/.cache/
build/
dist/

# ML Models (too large)
*.pt
*.h5
*.pth
runs/
segmentation_outputs/
segmented_portions/

# Temporary Files
uploads/
temp/
tmp/
*.tmp
logs/
*.log
server_output.log

# Database Files
*.db
*.sqlite
*.sqlite3

# Sensitive Information
*secret*
*credentials*
*key.pem
*key.pub
*access_key*

# Keep templates (DON'T ignore these)
!.env.example
!render.env
